# The keeper daemon: a wallet-shaped purse plus the watchtower knobs. Fund it with L-BTC
# for fees and OBOL for liquidations (`styx-wallet --config keeper.toml address` gives the
# purse address; any wallet's `send` pays into it).

styxnet = "/etc/styx/styxnet.toml"
rpc_url = "http://127.0.0.1:18884"
rpc_user = "styx"
rpc_password = "REPLACE"
snapshot = "/var/lib/styx/keeper-snapshot.json"
owner_seckey = "REPLACE"
funding_seckey = "REPLACE"

# Cadence knobs - the keeper's cost/risk dial. Fees now track the network rate (relayfee),
# so these mainly set how OFTEN the idle keeper spends at all.
# POKE when the issuer anchor lags the tip by more than this many blocks: bounds how stale a
# tick a mint can reuse during quiet spells. Lower = fresher floor, ~one poke fee every
# poke_lag+1 blocks; higher = cheaper idle keeper, looser bound. Mints/attests refresh it free.
poke_lag = 4
# REFRESH a healthy vault whose ratchet lags by more than this many blocks. Lower = vaults
# actionable sooner but more refresh fees; higher = cheaper but a brief post-quiet lag.
refresh_lag = 16
poll_ms = 1000
