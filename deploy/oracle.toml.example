# One oracle daemon = one quorum slot. Secrets from `styx-oracle --keygen` (the printed
# public halves go into styxnet.toml). Inline hex is the private-network phase's tradeoff;
# treat the file as a secret (chmod 600).

slot = 0
protocol_seckey = "REPLACE"
nostr_seckey = "REPLACE"
relays = ["ws://10.0.0.10:7877"]

# This machine's own elementsd (a follower).
rpc_url = "http://127.0.0.1:18884"
rpc_user = "styx"
rpc_password = "REPLACE"

# The debug/admin surface signs quotes on demand and moves the price: bind loopback or a
# trusted LAN interface only.
listen = "0.0.0.0:9700"
price_usd = 120000
poll_ms = 500

# The live price backend: the daemon polls the exchange's public spot ticker and signs the
# result; POST /price pins a sticky override on top (DELETE /price releases it). One
# exchange per slot keeps the quorum's five sources genuinely independent. Without this
# section the oracle stays in manual mode: price_usd + overrides only.
[feed]
backend = "coinbase"   # coinbase / binance / kraken / bitstamp / bitfinex / okx
poll_ms = 5000
# url = "http://..."   # endpoint override for tests and closed networks
# max_age_secs = 60     # staleness gate: stop publishing when the backend is silent this
                        # long - five gated oracles freeze the system safely (quorum
                        # degrades), five ungated ones re-sign a frozen price forever
